<script type="text/javascript">
    $("#success_fail_info").hide();
    $(document).ready(function() {
        $("#main_footer_form").submit(function(e) {
            e.preventDefault();
            var _this = $('#main_footer_form');
            var _token = $("#main_footer_form input[name='_token']").val();
            var email = $("#main_footer_form input[name='email']").val();
            $.ajax({
                url: "https://yennhamoc.vn/subcribers",
                type: 'POST',
                data: {
                    _token: _token,
                    email: email,
                },
                success: function(data) {
                    $("#success_fail_info").show();
                    if ($.isEmptyObject(data.error)) {
                        $("#success_fail_info").removeClass('text-red-700 bg-red-100 rounded-lg dark:bg-red-200 dark:text-red-800').addClass('text-green-700 bg-green-100 rounded-lg dark:bg-green-200 dark:text-green-800');
                        $("#success_fail_info span").html('Đăng ký thành công!');
                        setTimeout(function() {
                            location.reload();
                        }, 3000);
                    } else {
                        $("#success_fail_info").removeClass('text-green-700 bg-green-100 rounded-lg dark:bg-green-200 dark:text-green-800').addClass('text-red-700 bg-red-100 rounded-lg dark:bg-red-200 dark:text-red-800');
                        $("#success_fail_info span").html(data.error);
                    }
                }
            });
        });
    });
</script>    <!-- <script src="https://yennhamoc.vn/frontend/js/jquery.min.js"></script> -->



